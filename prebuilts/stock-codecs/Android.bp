    name: "vendor.dolby.hardware.dms@2.0-xuanyuan-stock",
    stem: "vendor.dolby.hardware.dms@2.0",
    defaults: ["xuanyuan_stock_codec_defaults"],
    srcs: ["system/lib64/vendor.dolby.hardware.dms@2.0.so"],
}
