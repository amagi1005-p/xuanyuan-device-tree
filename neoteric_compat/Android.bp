// The vendor CamX loader dlopens this absolute path; the SoC HAL lives in ODM.
install_symlink {
    name: "xuanyuan_camera_sm8750_vendor_path",
    soc_specific: true,
    installed_location: "lib64/hw/camera.qcom.sm8750.so",
    symlink_target: "/odm/lib64/hw/camera.qcom.sm8750.so",
    required: ["camera.qcom.sm8750"],
}

cc_prebuilt_binary {
    name: "vibratorfeature-wrapper-neoteric",
    enabled: true,
    stem: "vibratorfeature-wrapper",
    srcs: ["odm/bin/hw/vibratorfeature-wrapper"],
    device_specific: true,
    relative_install_path: "hw",
    strip: {
        none: true,
    },
    check_elf_files: false,
    init_rc: ["odm/etc/init/vibratorfeature-wrapper.rc"],
    vintf_fragments: ["odm/etc/vintf/manifest/android.hardware.vibrator.xml"],
}

