service xuanyuan-bootdiag /system/bin/sh /system_ext/bin/bootdiag.sh
    class core
    user root
    group root system log readproc
    seclabel u:r:shell:s0
    disabled
    oneshot

on post-fs
    mkdir /metadata/bootdiag 0777 root root
    chmod 0777 /metadata/bootdiag
    start xuanyuan-bootdiag
