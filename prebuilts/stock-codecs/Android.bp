cc_defaults {
    name: "xuanyuan_stock_codec_defaults",
    compile_multilib: "64",
    strip: { none: true },
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "liblhdc-xuanyuan-stock",
    stem: "liblhdc",
    defaults: ["xuanyuan_stock_codec_defaults"],
    srcs: ["system/lib64/liblhdc.so"],
}

cc_prebuilt_library_shared {
    name: "liblhdcv5-xuanyuan-stock",
    stem: "liblhdcv5",
    defaults: ["xuanyuan_stock_codec_defaults"],
    srcs: ["system/lib64/liblhdcv5.so"],
}

